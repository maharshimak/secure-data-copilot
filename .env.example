COPILOT_DATABASE_PATH=examples/demo.db
# Table allowlist is required for bearer-protected or model-backed database access.
# COPILOT_ALLOWED_TABLES=customers,orders
# COPILOT_ALLOWED_COLUMNS=customers.name,customers.segment,orders.amount,orders.created_at
# COPILOT_DENIED_COLUMNS=email
# Optional query-shape rule. Bearer-protected access also requires row scope when set.
# COPILOT_GUARDED_TABLES=orders
# Optional exact text scope for every allowed table. Configure both variables together.
# COPILOT_ROW_SCOPE_COLUMN=tenant_id
# COPILOT_ROW_SCOPE_VALUE=synthetic-tenant
# Optional JSONL audit log of allow/deny decisions with redacted diagnostics.
# COPILOT_AUDIT_LOG_PATH=data/audit.jsonl
