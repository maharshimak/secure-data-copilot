COPILOT_DATABASE_PATH=examples/demo.db
# Optional. Required for non-local API access.
COPILOT_API_TOKEN=
# Optional durable JSONL audit trail. Keep this path outside a public web root.
COPILOT_AUDIT_LOG_PATH=.data/audit/query-events.jsonl

# Optional guarded model planner. Set both or neither.
COPILOT_MODEL_BASE_URL=
COPILOT_MODEL=
COPILOT_MODEL_API_KEY=
COPILOT_MODEL_TIMEOUT_SECONDS=45

# Recommended whenever the model planner is enabled.
COPILOT_ALLOWED_TABLES=
COPILOT_DENIED_COLUMNS=
COPILOT_GUARDED_TABLES=
COPILOT_MAX_JOINS=4
